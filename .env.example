# Copy to .env.local. NEVER commit actual values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/brit_practice
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_ORIGIN=http://localhost:3000
# Bootstrap initial mentor account with npm run seed
SEED_MENTOR_EMAIL=mentor@britinstitute.co.uk
SEED_MENTOR_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SEED_LEARNER_EMAIL=learner@example.com
SEED_LEARNER_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Google Drive: OAuth as a dedicated human-owned Google account (My Drive folder)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Used only by scripted integrations; don't expose client-side.
INTEGRATION_API_KEY=

INTEGRATION_MENTOR_EMAIL=mentor@britinstitute.co.uk
